{
	"name": "taiko",
	"private": true,
	"version": "0.1.0",
	"description": "Site do Kodon Amazon Taiko: páginas institucionais, loja e área de alunos e instrutores",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:up": "docker compose up -d --wait db",
		"db:down": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.3.1",
		"@t3-oss/env-nextjs": "^0.13.11",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"framer-motion": "^12.26.2",
		"jspdf": "^4.2.1",
		"lucide-react": "^0.562.0",
		"next": "^16.4.6",
		"next-intl": "^4.16.2",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.1",
		"@biomejs/biome": "2.6.9",
		"@electric-sql/pglite": "^0.6.0",
		"@next/env": "^16.4.6",
		"@playwright/test": "^1.65.1",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"autoprefixer": "^10.4.21",
		"drizzle-kit": "^0.31.11",
		"postcss": "^8.5.6",
		"tailwindcss": "^3.4.17",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "~5.9.3",
		"unpdf": "^2.2.3",
		"vitest": "^5.1.2"
	}
}
